{
    "name": "rushing/laravel-popcorn-wasm",
    "description": "A wasmtime/WASI sandbox substrate for popcorn Runners — the portable, dev==prod route: an in-VM boundary running for-real on macOS, with Javy (JS→wasm) and CPython-WASI runtimes behind a WasmRuntime seam.",
    "keywords": ["laravel", "popcorn", "sandbox", "wasm", "wasmtime", "wasi", "javy", "runner", "isolation"],
    "license": "proprietary",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephenr85@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "rushing/laravel-popcorn": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../laravel-popcorn",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Rushing\\Popcorn\\Wasm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rushing\\Popcorn\\Wasm\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rushing\\Popcorn\\Wasm\\WasmServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint"
    }
}
